# Copy to .env locally. On Railway set these in the service's Variables tab.
# DISCORD_TOKEN must be marked SECRET there.
DISCORD_TOKEN=
# Optional. Narrows the channel search to one server; helps the logs say which
# servers are visible when the channel id does not resolve.
GUILD_ID=
VOICE_CHANNEL_ID=
POLL_MS=5000
READY_TIMEOUT_MS=30000
VERBOSE=1
NODE_ENV=production